# Compiled binaries (root-anchored so they do not match the cmd/<name>/ source dirs)
/cairn-ingest
/cairn-ingest.exe
/cairn-fs
/cairn-fs.exe
/cairn-server
/cairn-server.exe

# Block store directories (Badger + FS backends) and scratch/test stores
/store/
/store-*/
/cairn-store/
*-store/
**/testdata-store/

# Badger on-disk artifacts (in case a store lives outside the dirs above)
*.db
*.sst
*.vlog
*.mem
MANIFEST
KEYREGISTRY
DISCARD
LOCK

# Demo / scratch input data
/demo-data/

# Frontend (web/) — node deps and generated build output (built locally/CI,
# embedded into the binary with -tags embed_spa; not committed)
web/node_modules/
web/dist/

# Local secrets / configuration
.env
.env.local

# OS junk
.DS_Store
Thumbs.db
