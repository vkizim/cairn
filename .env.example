# Cairn local configuration — TEMPLATE.
# Copy to .env and fill in real values. .env is gitignored (never commit it).
#
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=disable

# Used by the repo/api tests and by cmd/cairn-fs.
CAIRN_TEST_DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/cairn_test?sslmode=disable

# --- cmd/cairn-server (step 3) ---
# Server DSN (falls back to CAIRN_TEST_DATABASE_URL if unset).
CAIRN_DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/cairn_test?sslmode=disable
CAIRN_LISTEN_ADDR=:8080
CAIRN_STORE=./cairn-store
CAIRN_STORE_BACKEND=badger
# Set to any non-empty value for local plain-http development: relaxes the
# Secure cookie attribute so cookies work over http://localhost.
CAIRN_DEV=

# Only read by `cairn-server create-user` (never logged). Leave unset to be
# prompted interactively on the terminal.
CAIRN_NEW_USER_PASSWORD=
